@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Af
@{ var email = (string?)ViewData["Email"] ?? ""; var token = (string?)ViewData["Token"] ?? ""; }
<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>DISCI – Đặt lại mật khẩu</title>
<script src="~/assets/theme-init.js"></script><link rel="stylesheet" href="~/assets/app.css"></head>
<body style="display:grid;place-items:center;min-height:100vh;padding:24px;font-family:Inter,system-ui,sans-serif">
<form id="f" style="width:100%;max-width:380px;display:grid;gap:12px">
<h1 style="font-size:26px">Đặt lại mật khẩu</h1>
<div id="m" role="alert"></div>
<label class="lbl" for="pw">Mật khẩu mới (≥ 8 ký tự, có chữ và số)</label>
<input class="field" id="pw" type="password" autocomplete="new-password" required minlength="8">
<label class="lbl" for="pw2">Nhập lại mật khẩu</label>
<input class="field" id="pw2" type="password" autocomplete="new-password" required>
<button class="btn btn-pri" type="submit">Đặt lại mật khẩu</button>
<a href="~/index.html" style="text-decoration:underline;text-align:center">Về trang đăng nhập</a>
</form>
<script>
(function(){
  var email=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(email)), token=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(token));
  var csrf=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Af.GetAndStoreTokens(Context).RequestToken));
  var m=document.getElementById('m');
  function say(t,ok){m.textContent=t;m.className='alert '+(ok?'alert-1':'alert-3');}
  document.getElementById('f').addEventListener('submit',function(e){
    e.preventDefault(); var a=document.getElementById('pw').value,b=document.getElementById('pw2').value;
    if(a!==b){say('Mật khẩu nhập lại không khớp.',false);return;}
    fetch('/Account/ResetPasswordApi',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','RequestVerificationToken':csrf},body:JSON.stringify({email:email,token:token,password:a})})
      .then(function(r){return r.json();}).then(function(j){say(j.message||'Đã xử lý.',!!j.ok); if(j.ok) setTimeout(function(){location.href='/index.html';},1500);})
      .catch(function(){say('Không kết nối được máy chủ. Vui lòng thử lại.',false);});
  });
})();
</script></body></html>
